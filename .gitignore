# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/

# Node / browser tests
node_modules/
test-results/
playwright-report/
blob-report/
.robot-out/

# Local environment
.env
.env.*
!.env.example
.ssh-config.local

# Runtime data
logs/
output/
tools/
# Loose log files at the repo root (e.g. uvicorn.log on the VPS). Not secrets, but
# logs can carry URLs, tokens in query strings, and IPs.
*.log

# macOS folder metadata
.DS_Store

# Local app state. Everything under data/ is runtime: job stores and their
# corrupt-file backups, session cookies, and browser-login profiles. None of it
# belongs in git, so the whole directory is ignored rather than named file by
# file — new runtime files are covered automatically.
# If you ever need a fixture in here, add it deliberately: git add -f data/<file>
data/

# Browser cookie databases. The robot copies Firefox's cookies.sqlite (plus its
# -wal/-shm sidecars) to a temp dir, but never let one land here by accident.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local editor / tooling config
.claude/

# Upstream recorder clone
vendor/tiktok-live-recorder/

# Hand-maintained list of TikTok accounts for the robot to check (personal)
.robot-follows
